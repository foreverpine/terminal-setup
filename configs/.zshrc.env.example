# ~/.zshrc.env — per-server environment, loaded BEFORE tool initialization.
# sync.sh seeds this file once; later syncs preserve it, including symlinks.
# Keep actual server settings outside Git. Use $HOME for portable paths.
# Keep functions, aliases and ZLE widgets in ~/.zshrc.local (loaded later).

# ─── PATH (Zsh array syntax preserves spaces; entries are deduplicated) ──
# path=("$HOME/.npm-global/bin" "$HOME/.opencode/bin" $path)
# path=("/opt/my-tools/bin" $path)  # only if this server uses that location
# export PATH
# export PNPM_HOME="$HOME/.local/share/pnpm"

# ─── Proxy (only enable when reachable from THIS server) ──────────────
# 127.0.0.1 refers to the server itself, not your laptop.
# Use the server's proxy endpoint or its local SSH tunnel port.
# export http_proxy="http://127.0.0.1:7890"
# export https_proxy="$http_proxy"
# export HTTP_PROXY="$http_proxy"
# export HTTPS_PROXY="$https_proxy"
# export no_proxy="localhost,127.0.0.1,::1,.example.internal"
# export NO_PROXY="$no_proxy"
# To explicitly disable inherited proxies on a server with direct access:
# unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY

# ─── Tool settings (available to initializers) ────────────────────────
# export EDITOR=vim
# export STARSHIP_CONFIG="$HOME/.config/starship.toml"
